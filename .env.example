# ==============================================================================
# POCKET UNIVERSE — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your values.
# NEVER commit the actual '.env' file to Git!

# ─── FIREBASE CONFIGURATION (Firestore Database) ─────────────────────────────
# Retrieve these values from Firebase Console -> Project Settings -> General -> Web App Config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ─── CLOUDINARY CONFIGURATION (Image & Audio Hosting) ────────────────────────
# Retrieve your cloud name and create an Unsigned Upload Preset in Cloudinary Settings -> Upload
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ─── ADMIN SECURITY & PERSONALIZATION ────────────────────────────────────────
# Secret PIN to unlock editing, adding, and deleting memories in the universe
VITE_SECRET_PIN=your_secret_admin_pin

# Display name for your partner (e.g. Phathyeehah). Defaults to "My Love" if omitted.
VITE_PARTNER_NAME=YourPartnerName
